# Copia a .env.local para desarrollo. En Netlify: Site settings → Environment variables.

# URL del backend (incluye /api al final)
NEXT_PUBLIC_API_URL=https://tu-backend.ejemplo.com/api

# WebSocket del backend (mismo host, esquema wss en producción)
NEXT_PUBLIC_WS_URL=wss://tu-backend.ejemplo.com

# Debe coincidir con PUBLIC_API_KEY del backend (solo rutas públicas del panel)
NEXT_PUBLIC_PUBLIC_API_KEY=

# Sitio público (QR, mis-boletas, textos WhatsApp). Sin barra final.
NEXT_PUBLIC_PUBLIC_SITE_URL=https://combotoyotas.com
